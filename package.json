{
  "name": "unity-emu-lab",
  "version": "0.1.0",
  "description": "MCP server and CLI to self-test Unity Android builds on an emulator: a device lease shared by several AI sessions, Unity-aware smoke checks (ready marker, crash or self-exit, ABI check, system dialogs), and checks outside the app (notification shade, tap back in, device clock).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "unity",
    "android",
    "emulator",
    "adb",
    "smoke-test",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyKim0115/unity-emu-lab.git"
  },
  "homepage": "https://github.com/cyKim0115/unity-emu-lab#readme",
  "bugs": {
    "url": "https://github.com/cyKim0115/unity-emu-lab/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "emu-lab": "bin/emu-lab.js",
    "unity-emu-lab": "bin/emu-lab.js"
  },
  "files": [
    "bin/",
    "dist/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/emu-lab.js serve",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
